{
  "name": "app-movil-ahorro-personal-domain",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo financiero independiente para metas de ahorro personales.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:portable && npm run build:node",
    "build:portable": "tsc -p tsconfig.build.json",
    "build:node": "tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
